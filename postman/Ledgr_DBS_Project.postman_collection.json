    {
      "name": "04. Transactions & Double-Entry Ledger",
      "item": [
        {
          "name": "List Transactions (Filtered by Year & Month)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?year=2026&month=6&userId=user-1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                {
                  "key": "year",
                  "value": "2026"
                },
                {
                  "key": "month",
                  "value": "6"
                },
                {
                  "key": "userId",
                  "value": "user-1"
                }
              ]
            }
          }
        },
        {
          "name": "Create Transaction (ACID Balance Sync)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": 1,\n  \"category_id\": 6,\n  \"amount\": -85.50,\n  \"note\": \"Team dinner at college cafe\",\n  \"description\": \"Celebration after DBS project submission\",\n  \"tx_date\": \"2026-11-15\",\n  \"tx_time\": \"19:30:00\",\n  \"payment_method_id\": 1,\n  \"userId\": \"user-1\",\n  \"paidForMemberId\": \"member-alex\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            },
            "description": "Atomically inserts transaction AND decrements account balance inside an ACID MySQL transaction."
          }
        },
        {
          "name": "Update Transaction Amount (Rebalance)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -95.00,\n  \"note\": \"Team dinner at college cafe (updated bill)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/7",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "7"]
            }
          }
        },
        {
          "name": "Delete Transaction (Restores Account Balance)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/7",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "7"]
            },
            "description": "Deletes transaction and automatically reverses the amount on the account balance atomically."
          }
        }
      ]
    },
