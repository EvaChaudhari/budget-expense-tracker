    {
      "name": "10. Domain Invariants & DBS Error Handling",
      "item": [
        {
          "name": "Reject Budget on Income Category (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"year\": 2026,\n  \"month\": 6,\n  \"amount\": 1000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/budgets/1/default",
              "host": ["{{baseUrl}}"],
              "path": ["budgets", "1", "default"]
            },
            "description": "Category 1 is 'Salary' (income). The backend rejects budgets on income categories with 400 Bad Request."
          }
        },
        {
          "name": "Reject Cross-Flow Category Reassignment (400)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reassignTo\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/categories/6",
              "host": ["{{baseUrl}}"],
              "path": ["categories", "6"]
            },
            "description": "Rejects reassigning expense transactions to an income category (Category 1)."
          }
        },
        {
          "name": "Reject Account Deletion with Transactions (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/1",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "1"]
            },
            "description": "Enforces ON DELETE RESTRICT foreign key integrity: account with transactions cannot be deleted."
          }
        },
        {
          "name": "Reject Invalid ID Path Parameter (400 Zod)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/invalid-string-id",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "invalid-string-id"]
            },
            "description": "Zod schema validation rejects non-integer path parameter with structured JSON error."
          }
        }
      ]
    }
