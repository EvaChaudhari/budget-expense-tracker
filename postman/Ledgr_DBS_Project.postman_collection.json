            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-1\",\n  \"title\": \"Hostel Wifi Broadband\",\n  \"amount\": 899.00,\n  \"type\": \"expense\",\n  \"category\": \"Bills\",\n  \"accountId\": 1,\n  \"frequency\": \"monthly\",\n  \"nextDueDate\": \"2026-12-01\",\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recurring",
              "host": ["{{baseUrl}}"],
              "path": ["recurring"]
            }
          }
        },
        {
          "name": "Process Due Recurring Payments (Atomic Batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"user-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/recurring/process",
              "host": ["{{baseUrl}}"],
              "path": ["recurring", "process"]
            },
            "description": "Scans recurring_transactions for due items, creates real transactions, updates account balances, and advances nextDueDate atomically."
          }
        }
      ]
