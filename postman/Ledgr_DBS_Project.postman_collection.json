{
  "info": {
    "_postman_id": "ledgr-dbs-api-collection-v1",
    "name": "Ledgr DBS Project — Backend REST API",
    "description": "Complete Postman collection for Database Systems (DBS) college project demonstration and evaluation.\nCovers CRUD, ACID balance synchronization, domain invariants, foreign keys, aggregations, and recurring payments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001/api",
      "type": "string"
    }
  ],
  "item": [
